From: Stefano Rivera <stefanor@debian.org>
Date: Fri, 8 May 2026 18:45:40 -0400
Subject: Use Debian's packaged wheels for --no-download

Generate wheel lists, hashes and attributes from Debian's shipped wheels packages.

Origin: vendor
Forwarded: not-needed
Last-Update: 2026-05-08
---
 src/virtualenv/seed/wheels/embed/__init__.py | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/src/virtualenv/seed/wheels/embed/__init__.py b/src/virtualenv/seed/wheels/embed/__init__.py
index 1b5e2a2..77d16e7 100644
--- a/src/virtualenv/seed/wheels/embed/__init__.py
+++ b/src/virtualenv/seed/wheels/embed/__init__.py
@@ -123,6 +123,29 @@ def _hash_bundled_wheel(path: Path) -> str:
     return digest.hexdigest()
 
 
+# Debian specific: Update BUNDLE_SUPPORT and BUNDLE_SHA256 to match pip wheels
+# shipped in /usr/share/python-wheels for base install.
+def list_available_wheels(versions):
+    bundle = {version: {} for version in versions}
+    wheel_files = []
+    for whl in Path(BUNDLE_FOLDER).iterdir():
+        wheel_files.append(Wheel.from_path(whl))
+        BUNDLE_SHA256[whl.name] = _hash_bundled_wheel(whl)
+
+    # Sort wheels so the latest compatible version wins
+    wheel_files.sort(key=lambda wheel: wheel.version_tuple)
+    for wheel in wheel_files:
+        if wheel.distribution in ['pip', 'setuptools', 'wheel']:
+            for version in versions:
+                if wheel.support_py(version):
+                    bundle[version][wheel.distribution] = wheel.name
+    return bundle
+
+
+BUNDLE_SUPPORT = list_available_wheels(BUNDLE_SUPPORT.keys())
+# End Debian specific
+
+
 __all__ = [
     "BUNDLE_FOLDER",
     "BUNDLE_SHA256",
